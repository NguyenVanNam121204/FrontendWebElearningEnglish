# Đây là file ví dụ cấu hình biến môi trường cho dự án Frontend
# Hãy sao chép file này thành file .env và thay đổi các giá trị phù hợp

# URL của Backend API (Cần khớp với cổng mà Backend của bạn đang chạy)
REACT_APP_API_BASE_URL=http://localhost:5030/api

# Các cấu hình khác nếu cần (Ví dụ: Key của bên thứ 3)
# REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id
# REACT_APP_FACEBOOK_APP_ID=your_facebook_app_id
